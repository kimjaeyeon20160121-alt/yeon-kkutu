extends layout

block Subject
	title *** JJO.KR 관리 페이지 ***

block JS
	script(type="text/javascript", src="/js/in_admin.min.js")
	script(type="text/javascript", src="/js/yeon_admin_words.js")
	
block Middle
	fieldset
		legend 자격
		input#db-password(type='password', placeholder='암호')
		input#db-lang(placeholder='테이블')
	fieldset
		legend 추가 요청 받기
		div
			button#injeong-go 조회
			div
				table
					thead: tr
						td 승인?
						td 링크
						td #
						td theme
						td writer
						td createdAt
					tbody#injeong-data
			button#injeong-everything 모두 승인
			button#injeong-nothing 모두 거절
			button#injeong-apply 적용
	fieldset
		legend 상점 DB 다루기
		div
			input#shop-word(placeholder='품목 (~ALL)')
			button#shop-go 조회
			button#shop-hide 숨기기
			div
				table
					thead: tr
						td #
						td cost
						td hit
						td term
						td group
						td updatedAt
						td options
						td name_ko_KR
						td desc_ko_KR
						td name_en_US
						td desc_en_US
					tbody#shop-data
			button#shop-add 추가
			button#shop-apply 적용
	fieldset
		legend 유저 DB 다루기
		div
			input#user-id(placeholder='ID')
			input#user-nick(placeholder='닉네임')
			button#user-go 조회
			div
				table
					thead: tr
						td #
						td money
						td kkutu
						td box
						td equip
						td exordial
						td server
						td lastLogin
						td black
						td blockedUntil
						td friends
					tbody#user-data
			button#user-apply 적용
	fieldset
		legend 유저 감시하기
		div
			input#gamsi-id(placeholder='ID (,로 구분)')
			button#gamsi-go 감시
			div
				table
					thead: tr
						td #
						td 닉네임
						td 서버
					tbody#gamsi-data
	fieldset
		legend 끄투 DB 다루기
		div
			input#db-word(placeholder='단어')
			button#db-go 조회
			div#word-data
				div#wd-id
				input#wd-flag
				table
					thead: tr
						td #
						td type
						td theme
						td mean
						td 행동
					tbody#wd-data
			div#word-flag
			div#word-hit
			button#word-add 추가
			button#db-apply 적용
	fieldset
		legend 끄투 DB에 단어 추가하기
		div
			input#db-theme(placeholder='주제 (~부터 적으면 검색)')
			textarea#db-list(rows=20, cols=100)
			button#db-ok 확인
	fieldset#yeon-word-manager
		legend 연끄투 단어 관리 (추가 / 일괄 삭제)
		div(style='padding: 12px; line-height: 1.9;')
			label(for='yeon-theme') 주제 코드 (예: OIJ, POK)
			input#yeon-theme(value='OIJ', placeholder='주제 코드', maxlength=8, style='width: 125px;')
			div
				label(for='yeon-words') 단어 목록 (한 줄에 한 단어, 여러 개 가능)
				textarea#yeon-words(rows=5, cols=65, placeholder='추가할 단어 또는 삭제할 단어 입력')
			div
				button#yeon-add(type='button') 단어 여러 개 추가
				button#yeon-preview(type='button') 주제 삭제 대상 미리보기
				button#yeon-check-words(type='button') 입력 단어 삭제 대상 확인
			pre#yeon-preview-result(style='white-space: pre-wrap; max-height: 220px; overflow: auto; background: #eee; padding: 10px;') 먼저 삭제 대상 미리보기를 실행하세요.
			div
				label(for='yeon-confirm') 확인 문구 (예: DELETE OIJ 24)
				input#yeon-confirm(placeholder='DELETE OIJ 24', style='width: 240px;')
			div
				button#yeon-delete-theme(type='button', style='background-color: #d55; color: white;') 주제 단어 일괄 삭제 (백업)
				button#yeon-delete-words(type='button', style='background-color: #b77; color: white;') 입력 단어 삭제 (백업)
			div#yeon-status(style='padding: 8px;')

	fieldset
		legend 끄투에서의 인기 단어
		button#kpw-query 조회
		textarea#kpw-html
		div#kpw-table
		button#kpw-flush 반영
